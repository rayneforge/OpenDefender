{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Service": {
    "TransportType": "Stdio",
    "CollectionFrequency": "00:15:00",
    "ConnectionString": "Data Source=diagnostic_reports.db",
    "LookbackHours": 24,
    "Llm": {
      "Provider": "Ollama",
      "Ollama": {
        "Endpoint": "http://localhost:11434",
        "Model": "gpt-oss:120b-cloud"
      },
      "OpenAi": {
        "ApiKey": "UseSecretManager",
        "Model": "gpt-4o"
      },
      "AzureOpenAi": {
        "Endpoint": "",
        "DeploymentName": "",
        "ApiKey": "UseSecretManager",
        "AuthenticationStrategy": "ApiKey"
      }
    }
  }
}
