meta {
  name: Perimeter Audit
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/agents/shield/perimeter-audit?publish=false
  body: none
  auth: none
}

params:query {
  publish: false
}

docs {
  Check firewall, auth failures, interface state, and packet anomalies.

  Returns PerimeterAuditResult: FirewallActive, OpenPortCount, AuthFailureCount, InterfaceIssues, PacketAnomalies, Flags, Level, Detail.

  Set publish=true to also dispatch the result to the task channel.
}
