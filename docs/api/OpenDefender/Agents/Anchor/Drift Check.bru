meta {
  name: Drift Check
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/agents/anchor/drift-check?publish=false
  body: none
  auth: none
}

params:query {
  publish: false
}

docs {
  Detect configuration drift from desired state.

  Returns DriftCheckResult: DriftDetected, DriftItems, Level, Detail.

  Set publish=true to also dispatch the result to the task channel.
}
