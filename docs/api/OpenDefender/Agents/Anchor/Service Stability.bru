meta {
  name: Service Stability
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/agents/anchor/service-stability?publish=false
  body: none
  auth: none
}

params:query {
  publish: false
}

docs {
  Check for failed or unstable services and timer health.

  Returns ServiceStabilityResult: AllServicesStable, FailedServiceCount, TimersHealthy, Flags, Level, Detail.

  Set publish=true to also dispatch the result to the task channel.
}
