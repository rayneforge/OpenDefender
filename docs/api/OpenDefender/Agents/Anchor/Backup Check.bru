meta {
  name: Backup Check
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/agents/anchor/backup-check?publish=false
  body: none
  auth: none
}

params:query {
  publish: false
}

docs {
  Verify backup chain integrity, snapshot recency, and encryption status.

  Returns BackupCheckResult: AllBackupsCurrent, EncryptionVerified, FailedSourceCount, Flags, Level, Detail.

  Set publish=true to also dispatch the result to the task channel.
}
